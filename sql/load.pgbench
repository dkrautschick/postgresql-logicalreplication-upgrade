-- pgbench custom script: one "guest rates a beer" transaction.
\set bid random(1, 16)
\set pid random(1, 5)
\set rating random(1, 5)
\set ml random(2, 5)
\set cents random(350, 750)
BEGIN;
INSERT INTO tastings (beer_id, pub_id, rating, pour_ml, price_cents)
  VALUES (:bid, :pid, :rating, :ml * 100, :cents) RETURNING id AS tid \gset
UPDATE beers SET checkins = checkins + 1 WHERE id = :bid;
UPDATE tastings SET rating = least(5, rating + 1)
  WHERE id = (SELECT id FROM tastings WHERE rating < 5 ORDER BY id DESC OFFSET 500 LIMIT 1);
INSERT INTO tap_log (note) VALUES ('tasting ' || :tid || ' at pub ' || :pid);
SELECT nextval('batch_number_seq');
COMMIT;
